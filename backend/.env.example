SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60
SERVER_BODY_LIMIT_BYTES=33554432
ALLOWED_ORIGINS=http://localhost:3001
# Production: https://app.domain.com

# Host-only API session cookie. Set SECURE=false only for local HTTP development.
AUTH_SESSION_COOKIE_NAME=convoza_session
AUTH_SESSION_COOKIE_MAX_AGE_SECONDS=1036800
AUTH_SESSION_COOKIE_SECURE=false

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Use http://meilisearch:7700 from the Compose backend container, or
# http://localhost:7700 when running the backend directly on the host.
MEILI_URL=http://localhost:7700
# Privileged server-side key. Compose also uses this as its development
# Meilisearch master key. Never copy this value to frontend/.env.local.
MEILI_API_KEY=
