NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase web app settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Used by the server-side cookie-auth boundary. Keep this JSON file out of Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
AUTH_COOKIE_NAME=__session
# AUTH_COOKIE_SIGNATURE_KEYS=replace-with-a-local-random-signing-key

# Optional Typesense search. Leave NEXT_PUBLIC_SEARCH_ENGINE unset for no-results search.
# Use NEXT_PUBLIC_SEARCH_ENGINE=typesense with the local Compose service.
NEXT_PUBLIC_SEARCH_ENGINE=
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY=xyz
