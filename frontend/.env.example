NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase web app settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Used by the server-side cookie-auth boundary. Keep this JSON file out of Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
AUTH_COOKIE_NAME=__session
# AUTH_COOKIE_SIGNATURE_KEYS=replace-with-a-local-random-signing-key

# Optional Meilisearch search. Leave NEXT_PUBLIC_SEARCH_ENGINE unset for no-results search.
NEXT_PUBLIC_SEARCH_ENGINE=meilisearch
NEXT_PUBLIC_MEILI_URL=http://localhost:7700
# Create a restricted search key with the runbook; never expose MEILI_API_KEY here.
NEXT_PUBLIC_MEILI_SEARCH_KEY=
